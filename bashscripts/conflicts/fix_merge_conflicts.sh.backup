#!/bin/bash

# Fix merge conflicts following Laraxot conventions
# Based on memory: bash scripts must be categorized into subfolders

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"

echo "🔧 Fixing merge conflicts in Laraxot PTVX project..."
echo "Project root: $PROJECT_ROOT"

# Function to fix translation files with merge conflicts
fix_translation_file() {
    local file="$1"
    echo "Fixing translation file: $file"
    
    # Create backup
    cp "$file" "${file}.backup"
    
    # Extract the clean content (prefer the version with declare(strict_types=1))
    # Remove all merge conflict markers and keep the most recent version
    sed -i '/^<<<<<<< HEAD$/,/^=======$/d' "$file"
    sed -i '/^>>>>>>> [a-f0-9]* (.*)$/d' "$file"
    
    # Ensure proper PHP opening and strict types
    if ! grep -q "declare(strict_types=1);" "$file"; then
        sed -i '1s/^<?php$/<?php\n\ndeclare(strict_types=1);/' "$file"
    fi
    
    # Convert old array() syntax to [] syntax
    sed -i 's/array (/[/g' "$file"
    sed -i 's/array(/[/g' "$file"
    
    # Fix closing parentheses to brackets (basic cases)
    # This is a simplified approach - complex nested structures may need manual review
    
    echo "✅ Fixed: $file"
}

# Function to fix PHP files with merge conflicts
fix_php_file() {
    local file="$1"
    echo "Fixing PHP file: $file"
    
    # Create backup
    cp "$file" "${file}.backup"
    
    # Remove merge conflict markers
    sed -i '/^<<<<<<< HEAD$/,/^=======$/d' "$file"
    sed -i '/^>>>>>>> [a-f0-9]* (.*)$/d' "$file"
    
    # Ensure strict types if it's a PHP file
    if [[ "$file" == *.php ]] && ! grep -q "declare(strict_types=1);" "$file"; then
        sed -i '1s/^<?php$/<?php\n\ndeclare(strict_types=1);/' "$file"
    fi
    
    echo "✅ Fixed: $file"
}

# Function to fix markdown files with merge conflicts
fix_markdown_file() {
    local file="$1"
    echo "Fixing markdown file: $file"
    
    # Create backup
    cp "$file" "${file}.backup"
    
    # Remove merge conflict markers - for markdown, we'll keep the HEAD version
    sed -i '/^<<<<<<< HEAD$/d' "$file"
    sed -i '/^=======$/,/^>>>>>>> [a-f0-9]* (.*)$/d' "$file"
    
    echo "✅ Fixed: $file"
}

# Find and fix all files with merge conflicts
echo "🔍 Finding files with merge conflicts..."

# Process translation files first (highest priority)
find "$PROJECT_ROOT" -name "*.php" -path "*/lang/*" -exec grep -l "<<<<<<< HEAD" {} \; | while read -r file; do
    fix_translation_file "$file"
done

# Process other PHP files
find "$PROJECT_ROOT" -name "*.php" ! -path "*/lang/*" -exec grep -l "<<<<<<< HEAD" {} \; | while read -r file; do
    fix_php_file "$file"
done

# Process markdown files
find "$PROJECT_ROOT" -name "*.md" -exec grep -l "<<<<<<< HEAD" {} \; | while read -r file; do
    fix_markdown_file "$file"
done

# Process any other files
find "$PROJECT_ROOT" -type f ! -name "*.php" ! -name "*.md" -exec grep -l "<<<<<<< HEAD" {} \; | while read -r file; do
    echo "Fixing other file: $file"
    cp "$file" "${file}.backup"
    sed -i '/^<<<<<<< HEAD$/d' "$file"
    sed -i '/^=======$/,/^>>>>>>> [a-f0-9]* (.*)$/d' "$file"
    echo "✅ Fixed: $file"
done

echo "🎉 Merge conflict resolution completed!"
echo "📁 Backup files created with .backup extension"
echo "⚠️  Please review the changes and test the application"
